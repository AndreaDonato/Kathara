##############################
### Generate Stable Secret ###
##############################

openssl rand -hex 32 > /proc/sys/net/ipv6/conf/eth0/stable_secret

##############################
###    Use Stable Secret   ###
##############################

sysctl -w net.ipv6.conf.eth0.addr_gen_mode=2

##############################
###  SLAAC on iface eth0   ###
##############################

echo "iface eth0 inet6 auto" > /etc/network/interfaces.d/eth0
ifup eth0
